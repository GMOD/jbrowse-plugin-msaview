{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "proseWrap": "always",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    ".test-jbrowse*",
    "CHANGELOG.md",
    "pnpm-lock.yaml"
  ],
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"],
        "modifiers": ["value"]
      },
      {
        "groupName": "mui-icons",
        "elementNamePattern": ["@mui/icons-material"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      ["side_effect", "side_effect_style"],
      "react",
      "value-builtin",
      "value-external",
      "mui-icons",
      ["value-parent", "value-sibling", "value-index"],
      "type",
      "unknown"
    ],
    "newlinesBetween": true,
    "ignoreCase": false
  }
}
