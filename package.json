{
  "version": "3.1.0",
  "license": "MIT",
  "name": "jbrowse-plugin-msaview",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-msaview.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "start": "node esbuild.mjs --watch",
    "format": "pnpm prettier --write .",
    "build": "tsc && NODE_ENV=production node esbuild.mjs && cp distconfig.json dist/config.json",
    "prebuild": "pnpm clean",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "check-text-source": "node scripts/check-text-source.mjs",
    "check-ebi-params": "node scripts/check-ebi-params.mjs",
    "check-mui-imports": "node scripts/check-mui-imports.mjs",
    "pretest": "rm -rf .test-jbrowse && npx @jbrowse/cli create .test-jbrowse --nightly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "node scripts/test-versions.mjs setup",
    "test:setup:version": "node scripts/test-versions.mjs setup",
    "test:versions": "node scripts/test-versions.mjs run",
    "test:version": "node scripts/test-versions.mjs run",
    "host-compat": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-msaview.umd.production.min.js",
    "prepack": "pnpm build",
    "check-ci": "node scripts/require-green-ci.mjs",
    "preversion": "pnpm check-ci && pnpm lint && pnpm build && pnpm host-compat",
    "version": "node -e \"console.log('export const version = \\'' + require('./package.json').version + '\\'')\" > src/version.ts && git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add src/version.ts CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@gmod/bgzf-filehandle": "^6.2.0",
    "g2p_mapper": "^2.1.5",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^5.13.0",
    "@jbrowse/plugin-linear-genome-view": "^4.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@mui/x-data-grid": "^9.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "git-cliff": "^2.13.1",
    "jsdom": "^30.0.1",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "msa-parsers": "^6.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "puppeteer": "^25.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-msaview": "^6.0.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
