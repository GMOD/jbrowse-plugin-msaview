{
  "version": "5.19.0",
  "license": "MIT",
  "name": "jbrowse-plugin-msaview",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-msaview.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "start": "node esbuild.mjs --watch",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "build": "tsc && NODE_ENV=production node esbuild.mjs && cp distconfig.json dist/config.json",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p test/tsconfig.json",
    "prebuild": "pnpm clean",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fast": "oxlint --deny-warnings",
    "lint:eslint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "check-text-source": "node scripts/check-text-source.mjs",
    "check-ebi-params": "node scripts/check-ebi-params.mjs",
    "check-host-floor": "node scripts/check-host-floor.mjs",
    "check-host-dep-pins": "node scripts/check-host-dep-pins.mjs",
    "pretest": "rm -rf .test-jbrowse && npx @jbrowse/cli create .test-jbrowse --nightly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "node scripts/test-versions.mjs setup",
    "test:setup:version": "node scripts/test-versions.mjs setup",
    "test:versions": "node scripts/test-versions.mjs run",
    "test:version": "node scripts/test-versions.mjs run",
    "readme-figure": "node scripts/readme-figure.mjs",
    "host-compat": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-msaview.esm.js",
    "prepack": "pnpm build",
    "check-ci": "node scripts/require-green-ci.mjs",
    "preversion": "pnpm check-ci && pnpm check-host-dep-pins && pnpm lint && pnpm lint:eslint && pnpm build && pnpm check-host-floor && pnpm host-compat",
    "version": "node -e \"console.log('export const version = \\'' + require('./package.json').version + '\\'')\" > src/version.ts && git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && (pnpm readme-figure || echo 'WARNING: README figure not refreshed, see above') && git add src/version.ts CHANGELOG.md docs/gallery",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@gmod/bgzf-filehandle": "^6.8.5",
    "g2p_mapper": "^2.3.1",
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@jbrowse/core": "5.0.0-beta.19",
    "@jbrowse/display-kit": "5.0.0-beta.19",
    "@jbrowse/mobx-state-tree": "^6.10.1",
    "@jbrowse/plugin-linear-genome-view": "5.0.0-beta.19",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@mui/system": "^9.6.0",
    "@mui/x-data-grid": "^9.18.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "git-cliff": "^2.14.2",
    "jsdom": "^31.0.1",
    "mobx": "^7.1.7",
    "mobx-react": "^10.0.4",
    "msa-parsers": "^11.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "pretty-bytes": "^7.2.0",
    "puppeteer": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-msaview": "^11.0.0",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "serve": "^14.2.8",
    "tsrs": "7.1.0-beta.tsrs4",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
